PORT=
MONGODB_URI=
CORS_ORIGIN=
FRONTEND_URL=

# Générer : openssl rand -hex 32  (16+ caractères obligatoires)
JWT_SECRET=
JWT_EXPIRES_IN=

# Compte admin créé automatiquement au premier démarrage
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# true = réinitialise le mot de passe de l'admin depuis ce .env au démarrage (récupération d'accès)
ADMIN_FORCE_PASSWORD_SYNC=

# Google Search Console (voir README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GSC_SITE=
# optionnel : ne suivre que les pages du blog
GSC_PAGE_FILTER=

# URL publique de l'API (couvertures générées hébergées sous /api/media/…). Obligatoire derrière un proxy / en production.
PUBLIC_API_URL=

# Framer (auto-publication des articles planifiés) — configurable aussi dans Settings → Framer
# Clé : Framer → Site Settings → API Keys (Server API). Node 22+ requis.
PUBLISH_TIMEZONE=
FRAMER_PROJECT_URL=
FRAMER_API_KEY=

# Max JSON body size (articles and social designs embed images as data URLs)
BODY_LIMIT=50mb

# ---- Social Media: connected accounts (one developer app per network; see README) ----
# Callback URL to register with each network: <PUBLIC_API_URL>/social/connections/callback/<ig|li|x|fb|tt>
# Instagram and TikTok download the post images from PUBLIC_API_URL: it must be a public https address.
# Meta (Facebook Pages + Instagram professional accounts)
META_APP_ID=
META_APP_SECRET=
# LinkedIn (Sign In with LinkedIn using OpenID Connect + Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X (OAuth 2.0, Web App, read and write)
X_CLIENT_ID=
X_CLIENT_SECRET=
# TikTok (Login Kit + Content Posting API, Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Telegram needs no app: connect a bot token + channel from Settings → Connected accounts.
# Optional: LINKEDIN_VERSION=YYYYMM (default: two months ago), META_GRAPH_VERSION=v23.0

# ---- Figma (Settings → Figma → Connect Figma) ----
# Create an OAuth app at https://www.figma.com/developers/apps and add this callback (redirect) URL:
#   <PUBLIC_API_URL>/social/figma/oauth/callback
# Tokens are stored encrypted (JWT_SECRET) and refreshed automatically.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# The redirect URL must be registered in the Figma app exactly as sent (else Figma shows "Invalid redirect uri"):
# Settings → Figma shows it with a Copy button. To register another URL instead, set it here, for example the
# frontend relay page (it forwards to the API callback):
# FIGMA_REDIRECT_URI=http://localhost:3000/social-media/figma/callback
# Optional. Default: current_user:read file_content:read file_metadata:read
# Add folders:read (private OAuth apps only) to browse team folders in the file picker.
# FIGMA_SCOPES=current_user:read file_content:read file_metadata:read folders:read

# ---- Social Media: live calendar posts rendered by the server (see README) ----
# Chromium loads <FRONTEND_URL>/social-media/render. Optional overrides:
# STUDIO_RENDER_URL=
# SOCIAL_LIVE_RENDER=off
# SOCIAL_LIVE_RENDER_TIMEOUT_MS=120000
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
